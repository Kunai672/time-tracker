{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".test-build",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "target": "ES2020",
    "incremental": false,
    "declaration": false,
    "sourceMap": false,
    "plugins": [],
    "types": ["node"]
  },
  "include": ["lib/**/*.ts", "components/**/*.ts", "components/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"],
  "exclude": ["node_modules", ".next"]
}
