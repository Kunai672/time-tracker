# Copy this file to `.env.local` and fill in both values from
# Supabase → Project Settings → API. Use only the publishable key; this app
# never needs the private server key. Both values are empty here on purpose —
# no credential is ever committed.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The live integration test in `tests/supabaseRepository.test.ts` reads the two
# names below instead of the app's `NEXT_PUBLIC_*` names. They take the same
# values, so map each one from the matching variable above when running it:
#
#   SUPABASE_TEST_URL="$NEXT_PUBLIC_SUPABASE_URL" \
#   SUPABASE_TEST_KEY="$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY" \
#   npm test
#
# With both unset the test is skipped and `npm test` stays offline.

SUPABASE_TEST_URL=$NEXT_PUBLIC_SUPABASE_URL
SUPABASE_TEST_KEY=$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
